<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@color/bg_primary"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp">

    <!-- ===== Top: Search bar ===== -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusDown="@id/resultsRecyclerView"
            android:nextFocusRight="@id/voiceButton" />

        <ImageButton
            android:id="@+id/voiceButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/bg_voice_button_selector"
            android:contentDescription="@string/voice_search_button"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:nextFocusLeft="@id/searchInput"
            android:nextFocusDown="@id/resultsRecyclerView" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSimulateVoice"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/simulate_voice"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/bg_app_button_selector"
            android:visibility="gone"
            android:nextFocusLeft="@id/voiceButton"
            android:nextFocusDown="@id/resultsRecyclerView"
            android:nextFocusUp="@id/searchInput" />

    </LinearLayout>

    <!-- ===== Middle: Provider label + RecyclerView + empty state ===== -->
    <TextView
        android:id="@+id/providerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@id/providerLabel"
        app:layout_constraintBottom_toTopOf="@id/appButtonsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_results"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/resultsRecyclerView"
        app:layout_constraintBottom_toBottomOf="@id/resultsRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/searchProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/accent_yellow"
        android:contentDescription="@string/loading_search"
        app:layout_constraintTop_toTopOf="@id/resultsRecyclerView"
        app:layout_constraintBottom_toBottomOf="@id/resultsRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Bottom: App buttons ===== -->
    <LinearLayout
        android:id="@+id/appButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/searchInLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_in_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"
            android:focusable="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNum"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="NUM"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_app_button_selector"
            android:nextFocusUp="@id/resultsRecyclerView"
            android:nextFocusRight="@id/btnSmartTube" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSmartTube"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="SmartTube"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_app_button_selector"
            android:nextFocusUp="@id/resultsRecyclerView"
            android:nextFocusLeft="@id/btnNum"
            android:nextFocusRight="@id/btnLampa" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLampa"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Lampa"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_app_button_selector"
            android:nextFocusUp="@id/resultsRecyclerView"
            android:nextFocusLeft="@id/btnSmartTube"
            android:nextFocusRight="@id/btnLazyMedia" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLazyMedia"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="LazyMedia"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_app_button_selector"
            android:nextFocusUp="@id/resultsRecyclerView"
            android:nextFocusLeft="@id/btnLampa"
            android:nextFocusRight="@id/serviceStatusText" />

    </LinearLayout>

    <!-- ===== Corner: Service status ===== -->
    <TextView
        android:id="@+id/serviceStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/resultsRecyclerView"
        android:nextFocusLeft="@id/btnLazyMedia"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_status_text_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
